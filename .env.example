# Copy to .env (never commit). All secrets are read from environment only.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# User token with clips:edit scope (only needed for Twitch Create Clip)
TWITCH_USER_TOKEN=
YOUTUBE_API_KEY=
# OAuth client for YouTube uploads (youtube.upload scope)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional LLM metadata (hard-capped by ai_budget_inr in config)
ANTHROPIC_API_KEY=
# Generate with: openssl rand -hex 24   (min 20 chars; "change-me" is rejected)
DASHBOARD_TOKEN=change-me
